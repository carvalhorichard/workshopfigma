# =============================================================
# Musique — modelo de variáveis de ambiente
#
# Copie para `.env` e preencha. Este arquivo (.env.example) É versionado
# de propósito: serve de documentação. Nunca coloque valores reais nele.
#
# Onde achar cada valor: Supabase › Project Settings › API Keys
# =============================================================

# Obrigatórias no front (embutidas no bundle — só valores públicos)
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
VITE_SUPABASE_PROJECT_REF=SEU_PROJETO

# Somente servidor — jamais com prefixo VITE_, jamais commitado.
# Cadastre direto na Vercel (Settings › Environment Variables).
# SUPABASE_SERVICE_ROLE_KEY=
# DATABASE_URL=postgresql://postgres:SENHA@db.SEU_PROJETO.supabase.co:5432/postgres
